# Supabase Postgres.
# Use o pooler transacional (porta 6543) durante a execução da aplicação.
DATABASE_URL="postgresql://postgres.popwzfduemgncsqiwayl:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use o pooler de sessão (porta 5432) para migrations e introspecção do Prisma.
DIRECT_URL="postgresql://postgres.popwzfduemgncsqiwayl:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Substitua [YOUR-PASSWORD] pela senha do banco. Se ela tiver caracteres
# especiais, aplique URL encoding antes de colocá-la na URL.

# Auth.js (NextAuth) — gere um segredo com: npx auth secret
# ou: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-forte"

# Em desenvolvimento, o Auth.js usa automaticamente o endereço da requisição.
# Em produção, defina AUTH_URL com a URL pública real da aplicação.

# OpenAI — necessária para o chat da assistente.
# Crie a chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Opcional: modelo usado no chat (padrão: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# Mapbox — mapa das unidades de saúde (/painel/unidades e /admin/unidades).
# Crie um token público em https://account.mapbox.com/access-tokens
# NEXT_PUBLIC_ porque o mapa roda no navegador, não no servidor.
#
# Vale só para unidade de saúde. A rede de apoio contra violência
# (SupportService) não tem — e não deve ganhar — latitude/longitude: um pino
# exato numa tela de proteção pode ser usado contra quem o app protege.
NEXT_PUBLIC_MAPBOX_TOKEN=""
